<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WanderLust</title>
</head>
<body>
    <h3>Create a new Listing</h3>
    <form method="post" action="/listings">
        <input name="title" placeholder="Enter your Title">
        <br>
        <br>
        <textarea name="description" placeholder="Enter your Description"></textarea>
        <br>
        <br>
        <input name="image" placeholder="Add img link">
        <br>
        <br>
        <input name="price" placeholder="Enter your Price">
        <br>
        <br>
        <input name="location" placeholder="Enter your Location">
        <br>
        <br>
        <input name="country" placeholder="Enter your Country">
        <br>
        <br>
        <button>Submit</button>
    </form>
</body>
</html>