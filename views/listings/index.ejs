<% layout("/layouts/boilerplate") %>

    <body>
        <br>
        <h3 class="offset-2">All Listings</h3>

        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 offset-2 ">
            <% for(let list of allListing) {%>
                <div class="card col" style="width: 20rem;">

                    <a href="/listings/<%=list._id%>" class="listing-link">
                        <img class="card-img-top" src="<%= list.image %>" alt="listing_img"
                            style="height: 20rem;">
                        <div class="card-body">
                            <p class="card-text">
                                <b>
                                    <%= list.title %>
                                </b><br>
                                Price &#8377;<%= list.price?.toLocaleString("en-IN") || 0 %>/night
                            </p>

                        </div>
                    </a>

                </div>


                <%}%>
        </div>


    </body>