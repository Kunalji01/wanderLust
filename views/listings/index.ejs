<% layout("/layouts/boilerplate") %>

    <body>
        <h3>All Listings</h3>

        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 ">
            <% for(let list of allListing) {%>
                <div class="card col" style="width: 20rem;">
                    <img class="card-img-top" src="<%= list.image %>" alt="listing_img">
                    <a href="/listings/<%=list._id%>"></a>
                    <div class="card-body">
                        <h5 class="card-title">
                            <%= list.title %>
                        </h5>
                        <p class="card-text">                           
                            Price &#8377;<%= list.price.toLocaleString("en-IN")%>/night
                        </p>

                    </div>
                </div>


            <%}%>
        </div>


    </body>