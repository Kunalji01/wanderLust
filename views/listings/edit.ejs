<% layout("/layouts/boilerplate") %>

    <body>
        <div class="row">
            <div class="col-8 offset-2">
                <br>
                <h4>Edit your Listing</h4>
                <form method="post" action="/listings/<%=listing._id%>?_method=PUT">
                    <div class="mb-3">
                        <label for="title" class="form-label">Title</label>
                        <input name="title" value="<%=listing.title%>" class="form-control">
                    </div>

                    <div class="mb-3">
                        <label for="description" class="form-label">Description</label>
                        <textarea name="description" class="form-control"><%=listing.description%></textarea>
                    </div>

                    <div class="mb-3">
                        <label for="image" class="form-label">Image</label>
                        <input name="image" value="<%=listing.image%>" class="form-control">
                    </div>

                    <div class="mb-3">
                        <label for="price" class="form-label">Price</label>
                        <input name="price" value="<%=listing.price%>" class="form-control">
                    </div>

                    <div class="mb-3">
                        <label for="location" class="form-label">Location</label>
                        <input name="location" value="<%=listing.location%>" class="form-control">
                    </div>

                    <div class="mb-3">
                        <label for="country" class="form-label">Country</label>
                        <input name="country" value="<%=listing.country%>" class="form-control">
                    </div>
                    <br>
                    <button class="btn btn-dark">Submit</button>
                    <br>
                    <br>
                </form>
            </div>
        </div>
    </body>

    </html>