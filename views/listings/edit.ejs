<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WanderLust</title>
</head>
<body>
    <form method="post" action="/listings/<%=listing._id%>?_method=PUT">
        <input name="title" value="<%=listing.title%>">
        <br>
        <br>
        <textarea name="description" ><%=listing.description%></textarea>
        <br>
        <br>
        <input name="image" value="<%=listing.image%>">
        <br>
        <br>
        <input name="price" value="<%=listing.price%>">
        <br>
        <br>
        <input name="location" value="<%=listing.location%>">
        <br>
        <br>
        <input name="country" value="<%=listing.country%>">
        <br>
        <br>
        
        <button>Submit</button>
    </form>
</body>
</html>